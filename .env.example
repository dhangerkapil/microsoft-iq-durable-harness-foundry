# Copy to .env.local (git-ignored) and fill in. Scripts dot-source scripts\Use-IsolatedAzure.ps1, which reads it.

# Isolated profile: sign-ins, Terraform state, the Python environment and work files live under
# %LOCALAPPDATA%\advisor-team\<TEAM_PROFILE>.
TEAM_PROFILE=demo
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
TEAM_LOCATION=eastus2

# Leave these empty to create everything from scratch. Set them to reuse existing shared resources
# under new names (logical isolation; see docs/ISOLATION.md).
EXISTING_FOUNDRY_ACCOUNT_ID=
EXISTING_FABRIC_CAPACITY_ID=
EXISTING_SEARCH_SERVICE_ID=

# The story's people. Names in WEB_BOUNDARY_TERMS never leave the boundary in a Web IQ query.
DEMO_ADVISOR_NAME=
DEMO_ANALYST_UPN=
DEMO_CLIENT_EMAIL=michael.scott@scott-family.example
WEB_BOUNDARY_TERMS=Michael Scott

# Story dates. STORY_MEETING_DATE moves the hydrated story's week (data/hydration, evals). To rehearse an existing story
# before its dates, give the agent a clock floor in terraform.tfvars instead:
#   agent_extra_environment = { ADVISOR_CLOCK_NOT_BEFORE = "2026-10-20T13:00:00Z" }
STORY_MEETING_DATE=
